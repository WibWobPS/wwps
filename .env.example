# Copy to .env and edit. docker-compose reads this file automatically.
# Generate the tokens with: openssl rand -hex 32

POSTGRES_USER=wwps
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wwps

# true for Wibble Wobble, false for Puni Puni.
WWPS_IS_WIB_WOB=true
WWPS_SERVER_NAME=WibWobPS
WWPS_GAME_VERSION=1.0.0
WWPS_LOG_LEVEL=INFO

# Where players reach this server, e.g. https://wwps.example.com. Leave empty
# for a LAN setup; set it whenever a proxy or a domain is in front.
WWPS_PUBLIC_URL=
WWPS_DATA_DOWNLOAD_URL=

# Only turn this on when a reverse proxy you control sets X-Forwarded-*.
WWPS_TRUST_PROXY_HEADERS=false

# The dashboard is only served when a token is set. Same for the admin API.
WWPS_DASHBOARD_ENABLED=true
WWPS_DASHBOARD_TOKEN=
WWPS_ADMIN_TOKEN=

WWPS_ENFORCE_ACCOUNT_OWNERSHIP=true
WWPS_VALIDATE_BEFRIEND=true
WWPS_RATE_LIMIT_ENABLED=true

# Gmail account used for the save-link codes. Leave empty to disable linking.
WWPS_EMAIL_FOR_AUTH_MESSAGES=
WWPS_APP_PASSWORD_FOR_AUTH_MESSAGES=

# Host interface and port to publish, e.g. 127.0.0.1:8080 behind a proxy.
WWPS_BIND=0.0.0.0:8080
